@page
@model ConfirmEmailModel
@{
    ViewData["Title"] = "Confirm email";
}

<h1>@ViewData["Title"]</h1>

<div class="row">
    <div class="col-md-8">
        @if (Model.IsConfirmed)
        {
            <div class="alert alert-success" role="alert">
                <h4 class="alert-heading">Email Confirmed!</h4>
                <p>Thank you for confirming your email. Your account is now fully activated.</p>
                <hr>
                <p class="mb-0">
                    You can now <a asp-page="./Login">log in</a> to your account.
                </p>
            </div>
        }
        else
        {
            <div class="alert alert-danger" role="alert">
                <h4 class="alert-heading">Email Confirmation Failed</h4>
                <p>@Model.ErrorMessage</p>
                <hr>
                <p class="mb-0">
                    Please <a asp-page="./Register">register again</a> or contact support if the problem persists.
                </p>
            </div>
        }
    </div>
</div>
